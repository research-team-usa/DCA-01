{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouterOutput",
  "type": "object",
  "required": [
    "router_id",
    "model_hash",
    "intent_label",
    "confidence_r",
    "dag_proposal",
    "latency_ms"
  ],
  "properties": {
    "router_id": {
      "type": "string"
    },
    "model_hash": {
      "type": "string",
      "pattern": "^sha256:"
    },
    "intent_label": {
      "type": "string"
    },
    "confidence_r": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dag_proposal": {
      "type": "object",
      "required": [
        "dag_hash",
        "nodes",
        "edges"
      ],
      "properties": {
        "dag_hash": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "reasoning_trace": {
      "type": "string"
    },
    "latency_ms": {
      "type": "integer"
    }
  }
}