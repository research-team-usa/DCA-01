{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FusionConstraint",
  "type": "object",
  "required": [
    "type",
    "detail",
    "dag_id",
    "failing_module"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "TYPE_MISMATCH",
        "UNIT_MISMATCH",
        "CONFIDENCE_GAP",
        "LOGIC_CONTRADICTION",
        "FORMAT_VIOLATION"
      ]
    },
    "detail": {
      "type": "string"
    },
    "expected": {
      "type": "object"
    },
    "actual": {
      "type": "object"
    },
    "delta": {
      "type": "number"
    },
    "dag_id": {
      "type": "string"
    },
    "failing_module": {
      "type": "string"
    }
  }
}